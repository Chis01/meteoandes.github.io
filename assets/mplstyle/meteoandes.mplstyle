figure.facecolor: #FBFCFD
axes.facecolor: #FBFCFD
axes.edgecolor: #5B6672
axes.labelcolor: #2C333C
axes.titleweight: bold
text.color: #12151A
xtick.color: #5B6672
ytick.color: #5B6672
grid.color: #DDE5EA
